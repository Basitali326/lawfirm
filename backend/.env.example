DJANGO_SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/lawfirm
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
DEFAULT_USER_PASSWORD=Welcome@12345

# File storage
STORAGE_BACKEND=local
MEDIA_ROOT=media
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage

# Documents upload policy
DOCUMENT_MAX_SIZE_MB=5
DOCUMENT_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx,ppt,pptx
ECOMMERCE_MAX_IMAGE_SIZE_MB=5
ECOMMERCE_ALLOWED_IMAGE_EXTENSIONS=png,jpg,jpeg,webp
